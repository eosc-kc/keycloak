<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="enable-unaccent-and-fix-search-path" author="cgeorgilakis">
        <!-- 1. Force unaccent into public schema public -->
        <sql dbms="postgresql">CREATE EXTENSION IF NOT EXISTS unaccent SCHEMA public;</sql>
        <sql dbms="postgresql">ALTER EXTENSION unaccent SET SCHEMA public;</sql>

        <sql dbms="postgresql">
            ALTER ROLE current_user SET search_path TO "$user", public, pg_catalog
        </sql>
    </changeSet>
</databaseChangeLog>