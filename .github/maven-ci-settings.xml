<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI-only Maven settings.

  repository.jboss.org frequently hangs or rate-limits (including the
  /nexus/content/groups/public/ -> /nexus/repository/public/ redirect).
  Keycloak modules still declare jboss-public-repository, and Maven tries it
  before Central for many artifacts that already exist on Central (e.g. Spotless).

  Mirroring those repository ids to Maven Central avoids the outage path while
  keeping resolution working for Central-hosted dependencies.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <mirrors>
    <mirror>
      <id>jboss-public-to-central</id>
      <name>Mirror JBoss public repositories to Maven Central</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>jboss-public-repository,jboss-public-repository-group</mirrorOf>
    </mirror>
  </mirrors>

</settings>
